{
  "name": "yovoice",
  "license": "Apache-2.0",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "playwright test",
    "lint": "eslint .",
    "check": "pnpm run lint && pnpm run build && pnpm test",
    "test:e2e:collect": "E2E_TELEMETRY_DISABLED=1 e2e list --config e2e.config.ts",
    "test:e2e": "E2E_TELEMETRY_DISABLED=1 e2e run --config e2e.config.ts --workers 1 --retries 0 --strict-cache"
  },
  "dependencies": {
    "@astryxdesign/core": "0.6.1",
    "@astryxdesign/theme-neutral": "0.6.1",
    "@stylexjs/stylex": "^0.19.0",
    "lucide-react": "^0.577.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.6.1",
    "@e2e-dev/web": "0.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "e2e": "0.19.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.1"
  },
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "patchedDependencies": {
      "@astryxdesign/core@0.6.1": "patches/@astryxdesign__core@0.6.1.patch"
    },
    "packageExtensions": {
      "@astryxdesign/core@0.6.1": {
        "dependencies": {
          "@floating-ui/dom": "1.8.0"
        }
      }
    }
  }
}
